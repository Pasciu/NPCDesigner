<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>NPCDesigner</AssemblyName>
    <Product>NPCDesigner</Product>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <NoWarn>$(NoWarn);CA1707;NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
    <RestoreAdditionalProjectSources>
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <!-- Override via: dotnet build -c Release -p:GameRootPath="C:\Path\To\Potion Craft" or POTION_CRAFT_DIR env var -->
    <GameRootPath Condition="'$(GameRootPath)' == '' and '$(POTION_CRAFT_DIR)' != ''">$(POTION_CRAFT_DIR)</GameRootPath>
    <GameRootPath Condition="'$(GameRootPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Potion Craft</GameRootPath>
    <ManagedDir>$(GameRootPath)\Potion Craft_Data\Managed</ManagedDir>
    <DeployToGame Condition="'$(DeployToGame)' == ''">false</DeployToGame>
    <ModPluginsDeployDir>$(GameRootPath)\BepInEx\plugins\NPCDesigner\</ModPluginsDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PotionCraft.Core">
      <HintPath>$(ManagedDir)\PotionCraft.Core.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="PotionCraft.ManagerSystem">
      <HintPath>$(ManagedDir)\PotionCraft.ManagerSystem.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="PotionCraft.Scripts">
      <HintPath>$(ManagedDir)\PotionCraft.Scripts.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="PotionCraft.Settings">
      <HintPath>$(ManagedDir)\PotionCraft.Settings.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(ManagedDir)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.SpriteMaskModule">
      <HintPath>$(ManagedDir)\UnityEngine.SpriteMaskModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedDir)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ThirdParty.DOTween">
      <HintPath>$(ManagedDir)\ThirdParty.DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**" />
  </ItemGroup>

  <Target Name="DeployToBepInEx" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true' and Exists('$(GameRootPath)')">
    <MakeDir Directories="$(ModPluginsDeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModPluginsDeployDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
